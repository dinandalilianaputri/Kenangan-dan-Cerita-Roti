---
// Footer.astro
---

<footer class="bg-stone-900 text-stone-300 border-t border-stone-800 mt-20 pt-16 pb-12">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
      
      <!-- Brand & Mission (2 cols) -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-500 to-amber-700 flex items-center justify-center text-white shadow-lg">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M17 8h1a4 4 0 1 1 0 8h-1"></path>
              <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"></path>
              <line x1="6" y1="2" x2="6" y2="4"></line>
              <line x1="10" y1="2" x2="10" y2="4"></line>
              <line x1="14" y1="2" x2="14" y2="4"></line>
            </svg>
          </div>
          <span class="font-serif-brand font-bold text-xl text-white">
            Kenangan & Cerita Roti
          </span>
        </div>
        <p class="text-stone-400 text-xs sm:text-sm leading-relaxed max-w-sm">
          Menyajikan kehangatan kopi arabika Nusantara dengan manisnya gula aren murni, berdampingan dengan kelembutan roti bantal khas Cerita Roti yang dipanggang dengan cinta setiap hari.
        </p>
        <div class="pt-2 flex items-center gap-3 text-stone-400">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-stone-800 border border-stone-700/60 text-xs text-amber-300">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Halal Indonesia Terverifikasi
          </span>
        </div>
      </div>

      <!-- Quick Nav Links -->
      <div class="space-y-3">
        <h4 class="font-bold text-white text-sm tracking-wider uppercase">Menu Favorit</h4>
        <ul class="space-y-2 text-xs sm:text-sm text-stone-400">
          <li><a href="#menu-section" class="hover:text-amber-400 transition-colors">Kopi Kenangan Mantan</a></li>
          <li><a href="#menu-section" class="hover:text-amber-400 transition-colors">Caramel Macchiato</a></li>
          <li><a href="#menu-section" class="hover:text-amber-400 transition-colors">Uji Matcha Latte</a></li>
          <li><a href="#menu-section" class="hover:text-amber-400 transition-colors">Roti Cokelat Klasik</a></li>
          <li><a href="#menu-section" class="hover:text-amber-400 transition-colors">Roti Daging Asap & Keju</a></li>
        </ul>
      </div>

      <!-- Operational Hours -->
      <div class="space-y-3">
        <h4 class="font-bold text-white text-sm tracking-wider uppercase">Jam Operasional</h4>
        <div class="space-y-2 text-xs sm:text-sm text-stone-400">
          <div>
            <span class="block font-semibold text-stone-200">Senin - Jumat</span>
            <span>07:30 - 22:00 WIB</span>
          </div>
          <div>
            <span class="block font-semibold text-stone-200">Sabtu - Minggu</span>
            <span>07:00 - 23:00 WIB</span>
          </div>
          <div class="pt-1">
            <span class="text-amber-400 text-xs font-medium">Layanan Takeaway & Delivery tersedia setiap hari.</span>
          </div>
        </div>
      </div>

      <!-- Outlets & Contact -->
      <div class="space-y-3">
        <h4 class="font-bold text-white text-sm tracking-wider uppercase">Hubungi Kami</h4>
        <div class="space-y-2 text-xs sm:text-sm text-stone-400">
          <p class="flex items-center gap-2">
            <span>📍</span>
            <span>Jabodetabek • Bandung • Surabaya • Bali</span>
          </p>
          <p class="flex items-center gap-2">
            <span>💬</span>
            <span class="text-stone-300">WhatsApp: +62 811-2345-6789</span>
          </p>
          <p class="flex items-center gap-2">
            <span>✉️</span>
            <span class="text-stone-300">halo@kenanganceritaroti.com</span>
          </p>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-stone-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone-500">
      <p>© {new Date().getFullYear()} Kenangan & Cerita Roti. Proyek Pelatihan MCL 4. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href="#menu-section" class="hover:text-stone-400 transition-colors">Kebijakan Privasi</a>
        <a href="#menu-section" class="hover:text-stone-400 transition-colors">Syarat & Ketentuan</a>
        <a href="#menu-section" class="hover:text-stone-400 transition-colors">Bantuan Kasir</a>
      </div>
    </div>
  </div>
</footer>
