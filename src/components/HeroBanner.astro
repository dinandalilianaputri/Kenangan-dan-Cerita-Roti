---
// HeroBanner.astro
const waNumber = '6281234567890';
const waText = encodeURIComponent('Halo Barista, saya tertarik dengan paket promo Kopi Kenangan & Cerita Roti. Boleh minta rekomendasi menunya?');
const waUrl = `https://wa.me/${waNumber}?text=${waText}`;
---

<section id="hero" class="relative overflow-hidden bg-gradient-to-b from-stone-900 via-stone-900 to-stone-800 text-stone-100 pt-8 pb-16 sm:pb-24">
  <!-- Subtle decorative background blurs -->
  <div class="absolute -top-24 -left-24 w-96 h-96 bg-amber-600/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/2 -right-24 w-96 h-96 bg-amber-800/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      
      <!-- Left Content -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-950/70 border border-amber-600/40 text-amber-300 text-xs sm:text-sm font-medium tracking-wide shadow-sm">
          <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" />
          </svg>
          <span>Pilihan Utama Pecinta Kopi & Roti Indonesia</span>
        </div>

        <!-- Headline -->
        <h1 class="font-serif-brand text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.15]">
          Secangkir Kenangan, <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-amber-400 to-amber-200">
            Sejuta Cerita Roti
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="text-stone-300 text-base sm:text-lg max-w-2xl mx-auto lg:mx-0 leading-relaxed font-light">
          Nikmati racikan espresso arabika Nusantara dengan legitnya gula aren murni, bersanding sempurna dengan roti bantal selembut awan yang dipanggang segar setiap hari.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3.5 pt-2">
          <!-- Primary CTA: Pesan Online -->
          <a
            href="#menu-section"
            class="px-7 py-3.5 rounded-xl bg-amber-600 hover:bg-amber-500 active:scale-95 text-white font-bold text-sm sm:text-base shadow-lg shadow-amber-900/40 hover:shadow-xl transition-all duration-200 flex items-center gap-2"
          >
            <span>Pesan Online Sekarang</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>

          <!-- WhatsApp CTA Button -->
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 active:scale-95 text-white font-semibold text-sm sm:text-base shadow-lg shadow-emerald-950/40 transition-all duration-200 flex items-center gap-2"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.06-2.029-.496-1.554-.649-2.581-2.22-2.659-2.325-.077-.105-.631-.84-.631-1.603 0-.764.398-1.141.542-1.297.144-.156.312-.195.416-.195.105 0 .208.001.299.006.096.005.226-.037.352.269.13.316.442 1.077.481 1.156.039.078.065.17.013.273-.052.104-.078.169-.156.26-.078.091-.164.204-.234.273-.078.078-.16.163-.069.319.091.156.404.667.868 1.08 1.019.907 1.25.992 1.428 1.07.178.078.283.065.387-.052.104-.117.442-.519.56-.699.117-.182.234-.152.39-.091.156.061.988.466 1.157.551.17.085.283.127.325.198.042.071.042.416-.102.821z" />
            </svg>
            <span>Pesan via WhatsApp</span>
          </a>

          <!-- Best Seller Shortcut -->
          <button
            type="button"
            id="hero-bestseller-btn"
            class="px-5 py-3.5 rounded-xl bg-stone-800/80 hover:bg-stone-700/80 text-stone-300 hover:text-white border border-stone-700 font-medium text-xs sm:text-sm transition-all duration-200 flex items-center gap-1.5 cursor-pointer"
          >
            <span class="text-amber-400">★</span>
            <span>Menu Terlaris</span>
          </button>
        </div>

        <!-- Quick highlights badges -->
        <div class="pt-6 border-t border-stone-800/80 grid grid-cols-3 gap-4 text-center lg:text-left">
          <div>
            <div class="text-xl sm:text-2xl font-bold text-amber-400">100%</div>
            <div class="text-xs text-stone-400 font-medium">Biji Kopi Arabika</div>
          </div>
          <div>
            <div class="text-xl sm:text-2xl font-bold text-amber-400">Fresh</div>
            <div class="text-xs text-stone-400 font-medium">Roti Hangat Harian</div>
          </div>
          <div>
            <div class="text-xl sm:text-2xl font-bold text-amber-400">4.9 / 5</div>
            <div class="text-xs text-stone-400 font-medium">50K+ Ulasan Puas</div>
          </div>
        </div>

      </div>

      <!-- Right Visual Grid -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <!-- Main visual card -->
          <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-stone-700/60 group">
            <img
              src="https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=800&q=80"
              alt="Kopi Kenangan Mantan dan Cerita Roti"
              class="w-full h-80 sm:h-96 object-cover group-hover:scale-105 transition-transform duration-700"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/30 to-transparent"></div>
            
            <!-- Floating tag on image -->
            <div class="absolute bottom-5 left-5 right-5 p-4 rounded-2xl bg-stone-900/90 backdrop-blur-md border border-stone-700/60 shadow-lg">
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-[11px] font-semibold text-amber-400 uppercase tracking-wider">Paket Kombo Favorit</span>
                  <p class="text-white font-bold text-base sm:text-lg">Kopi Mantan + Roti Cokelat</p>
                  <p class="text-stone-300 text-xs">Cuma Rp 28.000 <span class="line-through text-stone-500">Rp 30.000</span></p>
                </div>
                <button
                  type="button"
                  id="order-combo-btn"
                  class="px-3.5 py-2 rounded-xl bg-amber-600 hover:bg-amber-500 text-white font-bold text-xs shadow-md transition-colors cursor-pointer"
                >
                  Pesan
                </button>
              </div>
            </div>
          </div>

          <!-- Secondary floating sticker -->
          <div class="hidden sm:flex absolute -top-4 -right-4 bg-amber-500 text-stone-950 font-bold p-3 rounded-2xl shadow-xl border-2 border-stone-900 items-center gap-2 transform rotate-3">
            <span class="text-2xl">🥐</span>
            <div class="text-left leading-tight text-xs">
              <span class="block font-black text-sm">Cerita Roti</span>
              <span>Selalu Lembut</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  // Handle best seller button click
  const bestSellerBtn = document.getElementById('hero-bestseller-btn');
  if (bestSellerBtn) {
    bestSellerBtn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('filter-bestseller', { detail: { onlyBestSeller: true } }));
      const menuSection = document.getElementById('menu-section');
      if (menuSection) {
        menuSection.scrollIntoView({ behavior: 'smooth' });
      }
    });
  }

  // Handle combo order shortcut
  const orderComboBtn = document.getElementById('order-combo-btn');
  if (orderComboBtn) {
    orderComboBtn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-item-by-id', { detail: { id: 'kopi-kenangan-mantan' } }));
    });
  }
</script>
