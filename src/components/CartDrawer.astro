---
// CartDrawer.astro
---

<div
  id="cart-drawer-backdrop"
  class="fixed inset-0 z-50 bg-stone-950/60 backdrop-blur-xs opacity-0 pointer-events-none transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cart-drawer-title"
>
  <!-- Slide-out Drawer Panel -->
  <aside
    id="cart-drawer-panel"
    class="fixed inset-y-0 right-0 z-50 w-full max-w-md bg-stone-50 shadow-2xl flex flex-col transform translate-x-full transition-transform duration-300 ease-in-out border-l border-stone-200"
  >
    <!-- Drawer Header -->
    <div class="p-5 bg-stone-900 text-white flex items-center justify-between border-b border-stone-800 shrink-0">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-amber-600/80 flex items-center justify-center">
          <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
        </div>
        <div>
          <h2 id="cart-drawer-title" class="font-serif-brand font-bold text-lg text-white">Keranjang Pesanan</h2>
          <p id="cart-items-summary" class="text-xs text-stone-400 font-medium">0 Menu Dipilih</p>
        </div>
      </div>

      <button
        id="close-cart-drawer-btn"
        type="button"
        aria-label="Tutup keranjang"
        class="w-8 h-8 rounded-full bg-stone-800 hover:bg-stone-700 text-stone-300 hover:text-white flex items-center justify-center transition-all cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Free Delivery / Progress Banner -->
    <div class="bg-amber-100/70 border-b border-amber-200 p-3 px-5 text-xs text-amber-900 flex items-center justify-between">
      <span class="flex items-center gap-1.5 font-medium">
        <span>🎉</span>
        <span id="promo-status-text">Beli min. Rp 50.000 untuk Gratis Ongkir!</span>
      </span>
      <span class="font-bold text-amber-800" id="promo-percentage">0%</span>
    </div>

    <!-- Scrollable Items Container -->
    <div id="cart-items-list" class="flex-1 overflow-y-auto p-4 sm:p-5 space-y-3.5">
      <!-- Items will be injected dynamically via JS -->
    </div>

    <!-- Empty State Container -->
    <div id="cart-empty-view" class="flex-1 flex flex-col items-center justify-center p-8 text-center">
      <div class="w-20 h-20 rounded-full bg-amber-50 flex items-center justify-center text-4xl mb-4 border border-amber-200/50">
        🛒
      </div>
      <h3 class="font-bold text-stone-900 text-base">Keranjang Anda Masih Kosong</h3>
      <p class="text-xs text-stone-500 max-w-xs mt-1.5 leading-relaxed">
        Aroma kopi harum dan kelembutan roti sudah menunggumu. Yuk, pilih menu favoritmu sekarang!
      </p>
      <button
        id="cart-explore-btn"
        type="button"
        class="mt-6 px-6 py-2.5 rounded-full bg-amber-600 hover:bg-amber-700 text-white font-semibold text-xs sm:text-sm shadow-md transition-all cursor-pointer"
      >
        Mulai Pilih Menu
      </button>
    </div>

    <!-- Drawer Footer: Price Calculation & Checkout Trigger -->
    <div id="cart-footer-view" class="p-4 sm:p-5 bg-white border-t border-stone-200 space-y-3 shrink-0 hidden">
      
      <!-- Promo Code Input -->
      <div class="flex gap-2">
        <input
          id="promo-code-input"
          type="text"
          placeholder="Kode Promo: KENANGAN10"
          class="flex-1 px-3 py-1.5 text-xs bg-stone-50 border border-stone-200 rounded-lg uppercase tracking-wider font-semibold focus:outline-none focus:ring-1 focus:ring-amber-500"
        />
        <button
          id="apply-promo-btn"
          type="button"
          class="px-3.5 py-1.5 bg-stone-800 hover:bg-stone-900 text-white text-xs font-bold rounded-lg transition-colors cursor-pointer"
        >
          Pakai
        </button>
      </div>
      <div id="promo-applied-tag" class="hidden text-[11px] text-emerald-600 font-semibold flex items-center justify-between">
        <span>✓ Kupon Diskon Aktif: KENANGAN10</span>
        <button id="remove-promo-btn" class="text-red-500 hover:underline cursor-pointer">Hapus</button>
      </div>

      <!-- Pricing Summary Breakdown -->
      <div class="space-y-1.5 text-xs text-stone-600 border-t border-stone-100 pt-3">
        <div class="flex justify-between">
          <span>Subtotal Pesanan</span>
          <span id="cart-summary-subtotal" class="font-semibold text-stone-800">Rp 0</span>
        </div>
        <div id="cart-discount-row" class="hidden flex justify-between text-emerald-600 font-semibold">
          <span>Potongan Diskon</span>
          <span id="cart-summary-discount">-Rp 0</span>
        </div>
        <div class="flex justify-between">
          <span>Biaya Layanan & PB1 (10%)</span>
          <span id="cart-summary-tax" class="font-semibold text-stone-800">Rp 0</span>
        </div>
        <div class="flex justify-between text-sm sm:text-base font-extrabold text-stone-900 border-t border-stone-200 pt-2">
          <span>Total Pembayaran</span>
          <span id="cart-summary-total" class="text-amber-900 font-serif-brand">Rp 0</span>
        </div>
      </div>

      <!-- Checkout Button -->
      <button
        id="proceed-checkout-btn"
        type="button"
        class="w-full py-3.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-bold text-sm sm:text-base shadow-lg shadow-amber-900/30 active:scale-95 transition-all flex items-center justify-center gap-2 cursor-pointer"
      >
        <span>Lanjut ke Pembayaran</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>

    </div>

  </aside>
</div>

<script>
  import type { CartItem } from '../types/menu';

  const backdrop = document.getElementById('cart-drawer-backdrop');
  const panel = document.getElementById('cart-drawer-panel');
  const closeBtn = document.getElementById('close-cart-drawer-btn');
  const itemsList = document.getElementById('cart-items-list');
  const emptyView = document.getElementById('cart-empty-view');
  const footerView = document.getElementById('cart-footer-view');
  const exploreBtn = document.getElementById('cart-explore-btn');

  const itemsSummary = document.getElementById('cart-items-summary');
  const subtotalEl = document.getElementById('cart-summary-subtotal');
  const taxEl = document.getElementById('cart-summary-tax');
  const discountRow = document.getElementById('cart-discount-row');
  const discountEl = document.getElementById('cart-summary-discount');
  const totalEl = document.getElementById('cart-summary-total');
  const checkoutBtn = document.getElementById('proceed-checkout-btn');

  const promoInput = document.getElementById('promo-code-input') as HTMLInputElement | null;
  const applyPromoBtn = document.getElementById('apply-promo-btn');
  const promoAppliedTag = document.getElementById('promo-applied-tag');
  const removePromoBtn = document.getElementById('remove-promo-btn');
  const promoStatusText = document.getElementById('promo-status-text');
  const promoPercentage = document.getElementById('promo-percentage');

  // Local storage state
  const CART_STORAGE_KEY = 'mcl4_cart_items';
  let cartItems: CartItem[] = [];
  let discountAmount = 0;
  let activePromoCode: string | null = null;

  function loadCart() {
    try {
      const stored = localStorage.getItem(CART_STORAGE_KEY);
      if (stored) {
        cartItems = JSON.parse(stored);
      }
    } catch (e) {
      cartItems = [];
    }
  }

  function saveCart() {
    try {
      localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(cartItems));
    } catch (e) {}
  }

  function formatRp(num: number): string {
    return `Rp ${Math.max(0, num).toLocaleString('id-ID')}`;
  }

  function renderCart() {
    saveCart();

    const totalCount = cartItems.reduce((acc, item) => acc + item.quantity, 0);
    const subtotal = cartItems.reduce((acc, item) => acc + item.unitPrice * item.quantity, 0);
    const tax = Math.round(subtotal * 0.1); // 10% PB1 & service
    const finalTotal = Math.max(0, subtotal + tax - discountAmount);

    if (itemsSummary) {
      itemsSummary.textContent = `${totalCount} Menu Dipilih`;
    }

    // Free delivery progress calculation (Target Rp 50.000)
    const targetDelivery = 50000;
    const progress = Math.min(100, Math.round((subtotal / targetDelivery) * 100));
    if (promoPercentage) promoPercentage.textContent = `${progress}%`;
    if (promoStatusText) {
      if (subtotal >= targetDelivery) {
        promoStatusText.innerHTML = '🎉 <span class="font-bold text-emerald-800">Selamat! Anda mendapatkan Gratis Ongkir!</span>';
      } else {
        const remaining = targetDelivery - subtotal;
        promoStatusText.textContent = `Tambah ${formatRp(remaining)} lagi untuk Gratis Ongkir!`;
      }
    }

    // Toggle Empty vs Filled views
    if (cartItems.length === 0) {
      emptyView?.classList.remove('hidden');
      footerView?.classList.add('hidden');
      if (itemsList) itemsList.innerHTML = '';
    } else {
      emptyView?.classList.add('hidden');
      footerView?.classList.remove('hidden');

      if (itemsList) {
        itemsList.innerHTML = cartItems
          .map((ci) => {
            const opts = ci.selectedOptions;
            const optionsTags: string[] = [];

            if (opts?.temperature) {
              const icon = opts.temperature === 'Ice' ? '🧊' : '☕';
              optionsTags.push(`${icon} ${opts.temperature}`);
            }
            if (opts?.size) {
              optionsTags.push(`Ukuran: ${opts.size}`);
            }
            if (opts?.sugarLevel) {
              optionsTags.push(`Gula: ${opts.sugarLevel.split(' ')[0]}`);
            }
            if (opts?.iceLevel && opts.temperature === 'Ice') {
              optionsTags.push(opts.iceLevel);
            }
            if (opts?.notes) {
              optionsTags.push(`📝 "${opts.notes}"`);
            }

            const itemLineTotal = ci.unitPrice * ci.quantity;

            return `
              <div class="cart-item-card flex gap-3 p-3.5 bg-white rounded-2xl border border-stone-200/80 shadow-xs">
                <img
                  src="${ci.item.image}"
                  alt="${ci.item.name}"
                  class="w-16 h-16 rounded-xl object-cover shrink-0"
                />
                <div class="flex-1 min-w-0 flex flex-col justify-between">
                  <div>
                    <div class="flex items-start justify-between gap-2">
                      <h4 class="font-bold text-stone-900 text-xs sm:text-sm truncate">${ci.item.name}</h4>
                      <button
                        type="button"
                        class="delete-item-btn text-stone-400 hover:text-red-500 cursor-pointer p-0.5"
                        data-cart-id="${ci.cartItemId}"
                        title="Hapus menu ini"
                      >
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                      </button>
                    </div>

                    <!-- Customization pills -->
                    ${
                      optionsTags.length > 0
                        ? `
                      <div class="flex flex-wrap gap-1 mt-1">
                        ${optionsTags
                          .map(
                            (tag) => `
                          <span class="inline-block px-1.5 py-0.5 rounded text-[10px] bg-stone-100 text-stone-600 font-medium">${tag}</span>
                        `
                          )
                          .join('')}
                      </div>
                    `
                        : ''
                    }
                  </div>

                  <!-- Price & Stepper -->
                  <div class="mt-2.5 flex items-center justify-between">
                    <span class="font-bold text-amber-900 text-xs sm:text-sm font-serif-brand">
                      ${formatRp(itemLineTotal)}
                    </span>
                    <div class="flex items-center rounded-lg border border-stone-200 bg-stone-50 p-0.5">
                      <button
                        type="button"
                        class="cart-qty-btn-minus w-6 h-6 rounded bg-white text-stone-700 hover:bg-stone-200 flex items-center justify-center font-bold text-xs transition-colors cursor-pointer"
                        data-cart-id="${ci.cartItemId}"
                      >
                        -
                      </button>
                      <span class="w-6 text-center text-xs font-bold text-stone-800">${ci.quantity}</span>
                      <button
                        type="button"
                        class="cart-qty-btn-plus w-6 h-6 rounded bg-white text-stone-700 hover:bg-stone-200 flex items-center justify-center font-bold text-xs transition-colors cursor-pointer"
                        data-cart-id="${ci.cartItemId}"
                      >
                        +
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            `;
          })
          .join('');
      }
    }

    if (subtotalEl) subtotalEl.textContent = formatRp(subtotal);
    if (taxEl) taxEl.textContent = formatRp(tax);
    if (totalEl) totalEl.textContent = formatRp(finalTotal);

    if (discountAmount > 0) {
      discountRow?.classList.remove('hidden');
      if (discountEl) discountEl.textContent = `-${formatRp(discountAmount)}`;
    } else {
      discountRow?.classList.add('hidden');
    }

    // Emit event so Navbar badge can update
    window.dispatchEvent(
      new CustomEvent('cart-updated', {
        detail: {
          items: cartItems,
          subtotal,
          tax,
          discount: discountAmount,
          total: finalTotal,
        },
      })
    );
  }

  function openDrawer() {
    if (backdrop && panel) {
      backdrop.classList.remove('opacity-0', 'pointer-events-none');
      panel.classList.remove('translate-x-full');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeDrawer() {
    if (backdrop && panel) {
      backdrop.classList.add('opacity-0', 'pointer-events-none');
      panel.classList.add('translate-x-full');
      document.body.style.overflow = '';
    }
  }

  // Open & Close triggers
  window.addEventListener('toggle-cart', ((e: CustomEvent) => {
    if (e.detail?.open) {
      openDrawer();
    } else {
      closeDrawer();
    }
  }) as EventListener);

  if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', (e) => {
    if (e.target === backdrop) closeDrawer();
  });

  if (exploreBtn) {
    exploreBtn.addEventListener('click', () => {
      closeDrawer();
      const menuSection = document.getElementById('menu-section');
      if (menuSection) menuSection.scrollIntoView({ behavior: 'smooth' });
    });
  }

  // Add Item Handler
  window.addEventListener('add-to-cart', ((e: CustomEvent) => {
    const { cartItem } = e.detail || {};
    if (!cartItem) return;

    // Check if item with identical options already exists
    const existingIndex = cartItems.findIndex((it) => it.cartItemId === cartItem.cartItemId);
    if (existingIndex > -1) {
      cartItems[existingIndex].quantity += cartItem.quantity;
    } else {
      cartItems.push(cartItem);
    }

    renderCart();
  }) as EventListener);

  // Item List delegation for minus, plus, delete
  itemsList?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    // Delete
    const deleteBtn = target.closest('.delete-item-btn') as HTMLElement;
    if (deleteBtn) {
      const cartId = deleteBtn.dataset.cartId;
      cartItems = cartItems.filter((it) => it.cartItemId !== cartId);
      renderCart();
      return;
    }

    // Minus
    const minusBtn = target.closest('.cart-qty-btn-minus') as HTMLElement;
    if (minusBtn) {
      const cartId = minusBtn.dataset.cartId;
      const it = cartItems.find((x) => x.cartItemId === cartId);
      if (it) {
        if (it.quantity > 1) {
          it.quantity--;
        } else {
          cartItems = cartItems.filter((x) => x.cartItemId !== cartId);
        }
        renderCart();
      }
      return;
    }

    // Plus
    const plusBtn = target.closest('.cart-qty-btn-plus') as HTMLElement;
    if (plusBtn) {
      const cartId = plusBtn.dataset.cartId;
      const it = cartItems.find((x) => x.cartItemId === cartId);
      if (it) {
        it.quantity++;
        renderCart();
      }
      return;
    }
  });

  // Promo Code handling
  if (applyPromoBtn && promoInput) {
    applyPromoBtn.addEventListener('click', () => {
      const code = promoInput.value.trim().toUpperCase();
      if (code === 'KENANGAN10' || code === 'MCL4') {
        discountAmount = 10000;
        activePromoCode = code;
        promoInput.value = '';
        promoAppliedTag?.classList.remove('hidden');
        renderCart();
        window.dispatchEvent(
          new CustomEvent('show-toast', {
            detail: {
              title: 'Promo Berhasil!',
              message: 'Diskon Rp 10.000 telah diaplikasikan ke total pesanan.',
              type: 'success',
            },
          })
        );
      } else {
        window.dispatchEvent(
          new CustomEvent('show-toast', {
            detail: {
              title: 'Kode Tidak Valid',
              message: 'Gunakan kode "KENANGAN10" atau "MCL4".',
              type: 'error',
            },
          })
        );
      }
    });
  }

  if (removePromoBtn) {
    removePromoBtn.addEventListener('click', () => {
      discountAmount = 0;
      activePromoCode = null;
      promoAppliedTag?.classList.add('hidden');
      renderCart();
    });
  }

  // Proceed to Checkout
  if (checkoutBtn) {
    checkoutBtn.addEventListener('click', () => {
      if (cartItems.length === 0) return;
      closeDrawer();
      window.dispatchEvent(
        new CustomEvent('open-checkout-modal', {
          detail: {
            items: cartItems,
            discount: discountAmount,
          },
        })
      );
    });
  }

  // Listen to clear cart (after order completed)
  window.addEventListener('clear-cart', () => {
    cartItems = [];
    discountAmount = 0;
    activePromoCode = null;
    promoAppliedTag?.classList.add('hidden');
    renderCart();
  });

  // Initial setup
  loadCart();
  renderCart();
</script>
